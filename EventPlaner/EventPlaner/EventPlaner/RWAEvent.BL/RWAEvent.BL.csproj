<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoMapper" Version="16.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="8" />
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Resources\Event.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Event.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\EventType.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>EventType.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\Performer.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Performer.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\Reservation.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Reservation.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\User.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>User.resx</DependentUpon>
	  </Compile>
	  <Compile Update="Resources\ValidationMessages.Designer.cs">
	    <DependentUpon>ValidationMessages.resx</DependentUpon>
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="Resources\Event.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Event.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\EventType.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>EventType.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\Performer.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Performer.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\Reservation.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>Reservation.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\User.resx">
	    <Generator>PublicResXFileCodeGenerator</Generator>
	    <LastGenOutput>User.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\ValidationMessages.en.resx">
	    <CustomToolNamespace></CustomToolNamespace>
	    <Generator></Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\ValidationMessages.hr.resx">
	    <SubType>Designer</SubType>
	    <CustomToolNamespace></CustomToolNamespace>
	    <Generator></Generator>
	  </EmbeddedResource>
	  <EmbeddedResource Update="Resources\ValidationMessages.resx">
	    <CustomToolNamespace></CustomToolNamespace>
	    <LastGenOutput>ValidationMessages.Designer.cs</LastGenOutput>
	    <Generator>PublicResXFileCodeGenerator</Generator>
	  </EmbeddedResource>
	</ItemGroup>
</Project>
