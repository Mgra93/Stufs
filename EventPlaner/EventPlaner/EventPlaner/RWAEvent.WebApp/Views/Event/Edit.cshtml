@model RWAEvent.WebApp.ViewsModel.EventEditVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="app-title">@Localizer["lblTitle"]</h2>

            @using (Html.BeginForm("Edit", "Event", FormMethod.Post))
            {
                @Html.HiddenFor(m => m.Event.Id)

                <div class="mb-2">
                    @Html.LabelFor(m => m.Event.Title, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.Event.Title, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Event.Title, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.Event.EventTypeId, new { @class = "form-label app-label" })
                    @Html.DropDownListFor(m => m.Event.EventTypeId, new SelectList(Model.EventTypes, "Id", "Name", Model.Event.EventTypeId), new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.Event.EventTypeId, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.Event.Price, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.Event.Price, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Event.Price, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.Event.Time, new { @class = "form-label app-label" })
                    @Html.TextBox("Event.Time", Model.Event.Time.ToString("yyyy-MM-ddTHH:mm"), new { @class = "form-control", type = "datetime-local" })
                    @Html.ValidationMessageFor(m => m.Event.Time, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-2">
                    @Html.LabelFor(m => m.Event.Location, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.Event.Location, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Event.Location, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label app-label">@Localizer["lblAddPerformer"]</label>

                    <div class="input-group mb-2">
                        <select id="performerSelect" class="form-select form-select-sm">
                            <option value="">@Localizer["ddlSelectPerformer"]</option>
                            @foreach (var performer in Model.PerformerList)
                            {
                                <option value="@performer.Id">
                                    @(string.IsNullOrWhiteSpace(performer.LastName) ? performer.Name : $"{performer.Name} {performer.LastName}")
                                </option>
                            }
                        </select>
                        <button type="button" class="btn btn-primary btn-sm" onclick="addPerformer()">+</button>
                    </div>

                    @Html.LabelFor(m => m.Event.SelectedPerformerIds, new { @class = "form-label app-label" })

                    <ul id="selectedPerformers" class="list-group">
                        @foreach (var id in Model.Event.SelectedPerformerIds)
                        {
                            var performer = Model.PerformerList.FirstOrDefault(p => p.Id == id);
                            if (performer != null)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center" data-id="@id">
                                    @(string.IsNullOrWhiteSpace(performer.LastName) ? performer.Name : $"{performer.Name} {performer.LastName}")
                                    <button type="button" class="btn-close btn-close-sm" aria-label="Remove" onclick="removePerformer(@id)"></button>
                                    <input type="hidden" name="Event.SelectedPerformerIds" value="@id" />
                                </li>
                            }
                        }
                    </ul>
                </div>
                <div>
                    @Html.ValidationMessageFor(m => m.Event.SelectedPerformerIds, "", new { @class = "text-danger small" })
                </div>

                <div class="row mt-4">
                    <div class="col-6">
                        <button type="submit" class="btn btn-success btn-lg w-100">
                            @Localizer["btnSave"]
                        </button>
                    </div>
                    <div class="col-6">
                        <a href="/Event/List" class="btn btn-danger btn-lg w-100 d-flex align-items-center justify-content-center">
                            <i class="bi bi-arrow-left me-2"></i> @Localizer["btnBack"]
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function addPerformer() {
            const select = document.getElementById("performerSelect");
            const selectedId = select.value;
            const selectedText = select.options[select.selectedIndex]?.text;

            if (!selectedId || document.querySelector(`#selectedPerformers li[data-id="${selectedId}"]`)) return;

            const li = document.createElement("li");
            li.className = "list-group-item d-flex justify-content-between align-items-center";
            li.setAttribute("data-id", selectedId);
            li.innerHTML = `
                ${selectedText}
                <button type="button" class="btn-close btn-close-sm" aria-label="Remove" onclick="removePerformer(${selectedId})"></button>
                <input type="hidden" name="Event.SelectedPerformerIds" value="${selectedId}" />
            `;

            document.getElementById("selectedPerformers").appendChild(li);
            select.value = "";
        }

        function removePerformer(id) {
            const item = document.querySelector(`#selectedPerformers li[data-id="${id}"]`);
            if (item) item.remove();
        }
    </script>
}
