@using Microsoft.AspNetCore.Mvc.Localization
@using RWAEvent.BL.Models.DTO
@using RWAEvent.BL.Models.DTO.Event
@using RWAEvent.BL.Models.DTO.Reservation
@model RWAEvent.WebApp.ViewsModel.EventVM
@inject IViewLocalizer Localizer

@{
    var tempEvent = new EventDTO();
    var tempReservation = new ReservationDTO();
}

<div class="container mt-4">
    <h2 class="app-title">@Localizer["lblTitle"]</h2>

    @using (Html.BeginForm("List", "Event", FormMethod.Get, new { id = "filterForm", @class = "row g-3 align-items-end" }))
    {
        <div class="col-md-2">
            @Html.LabelFor(m => m.Filter.EventTypeId, new { @class = "form-label app-label" })
            <select name="EventTypeId" class="form-select">
                <option value="">@Localizer["lblAll"]</option>
                @foreach (var et in Model.EventTypes)
                {
                    <option value="@et.Id">@et.Name</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            @Html.LabelFor(m => m.Filter.Search, new { @class = "form-label app-label" })
            <input type="text" name="Search" class="form-control" placeholder="@Localizer["lblSearchInput"]" />
        </div>

        <div class="col-md-2">
            @Html.LabelFor(m => m.Filter.DateFrom, new { @class = "form-label app-label" })
            <input type="date" name="DateFrom" class="form-control" lang="hr" />
        </div>

        <div class="col-md-2">
            @Html.LabelFor(m => m.Filter.DateTo, new { @class = "form-label app-label" })
            <input type="date" name="DateTo" class="form-control" lang="hr" />
        </div>

        <div class="col-md-2">
            <button type="button" class="btn btn-danger d-flex align-items-center justify-content-center"
                    style="width: 40px; height: 40px; border-radius: 50%; padding: 0;"
                    id="btnClearFilters">
                <i class="bi bi-trash text-white" style="font-size: 1.5rem;"></i>
            </button>
        </div>

        <div class="col-md-2 d-flex justify-content-end gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a href="/Event/Create" class="btn btn-success d-flex align-items-center justify-content-center"
                   style="width: 40px; height: 40px; border-radius: 50%; padding: 0;">
                    <i class="bi bi-calendar-plus text-white" style="font-size: 1.5rem;"></i>
                </a>
            }

            <button type="submit" class="btn btn-warning d-flex align-items-center justify-content-center px-3"
                    style="height: 38px; min-width: 110px;">
                <i class="bi bi-funnel-fill me-2"></i>
            </button>
        </div>
        <div>
            @Html.ValidationMessageFor(m => m.CurrentPage, "", new { @class = "text-danger small" })
            @Html.ValidationMessageFor(m => m.Filter, "", new { @class = "text-danger small" })
            @Html.ValidationMessageFor(m => m.Events, "", new { @class = "text-danger small" })
            @Html.ValidationMessageFor(m => m.EventTypes, "", new { @class = "text-danger small" })
        </div>
    }

    <div class="mt-4" id="eventsContainer"></div>

    <nav aria-label="Event pagination" class="d-flex justify-content-center mt-4">
        <ul id="pagination" class="pagination"></ul>
    </nav>
</div>

<div class="modal fade" id="eventDetailModal" tabindex="-1" aria-labelledby="eventDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered event-modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #3a9ad9; color: white;">
                <h5 class="modal-title" id="eventDetailModalLabel"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hiddenEventId" />
                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-2">
                            @Html.LabelFor(m => tempEvent.EventTypeId, new { @class = "form-label app-label" }) :
                            <span id="modalEventType"></span>
                        </div>
                        <div class="mb-2">
                            @Html.LabelFor(m => tempEvent.Price, new { @class = "form-label app-label" }) :
                            <span id="modalPrice"></span> €
                        </div>
                        <div class="mb-2">
                            @Html.LabelFor(m => tempEvent.Location, new { @class = "form-label app-label" }) :
                            <span id="modalLocation"></span>
                        </div>
                        <div class="mb-2">
                            @Html.LabelFor(m => tempEvent.Time, new { @class = "form-label app-label" }) :
                            <span id="modalTime"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div>
                            @Html.LabelFor(m => tempEvent.SelectedPerformerIds, new { @class = "form-label  app-label", placeholder = Localizer["lblSearchPlaceholder"].Value })
                        </div>
                        <ul id="modalPerformers" class="performer-list"></ul>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 mt-3">
                    @if (User.IsInRole("User"))
                    {
                        @Html.LabelFor(m => tempReservation.TicketNumber, new { @class = "form-label app-label" })
                        <input type="number" class="form-control form-control-sm" style="width: 60px;" id="ticketQuantity" value="1" min="1" max="10">
                        <button type="button" class="btn btn-success" id="btnAddToCart">
                            <i class="bi bi-cart-plus"></i> @Localizer["btnAddToCart"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let eventModal;

        async function loadEvents(page = 1) {
            try {
                currentPage = page;

                const form = document.getElementById("filterForm");
                const formData = new FormData(form);
                formData.set("page", page);

                const params = new URLSearchParams(formData);
                const response = await fetch(`/Event/GetEventList?${params.toString()}`);
                if (!response.ok) throw new Error("Failed to load events.");

                const html = await response.text();
                document.getElementById("eventsContainer").innerHTML = html;

                setPagination();
                showModal();
            } catch (err) {
                console.error("Error loading events:", err);
            }
        }

        function setPagination() {
            document.querySelectorAll('#eventsContainer .pagination .page-link').forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    const page = parseInt(link.getAttribute('data-page'));
                    if (page) loadEvents(page);
                });
            });
        }

        function showModal() {
            document.querySelectorAll('#eventsContainer .custom-card').forEach(card => {
                card.addEventListener('click', function() {
                    const id = card.dataset.id;
                    document.getElementById('hiddenEventId').value = id;
                    document.querySelector('#eventDetailModal .modal-title').textContent = card.dataset.title;
                    document.getElementById('modalEventType').textContent = card.dataset.eventtype;
                    document.getElementById('modalPrice').textContent = card.dataset.price;
                    document.getElementById('modalLocation').textContent = card.dataset.location;
                    document.getElementById('modalTime').textContent = card.dataset.time;

                    const performers = JSON.parse(card.dataset.performers || '[]');
                    const ul = document.getElementById('modalPerformers');
                    ul.innerHTML = '';

                    performers.forEach(p => {
                        const li = document.createElement('li');
                        const name = p.name ?? p.Name;
                        const lastName = p.lastName ?? p.LastName;

                        li.textContent = lastName ? `${name} ${lastName}` : name;
                        ul.appendChild(li);
                    });
                    eventModal.show();
                });
            });
        }

        async function addToCart() {
            try {
                const cartCountSpan = document.getElementById('cartCount');
                const quantity = parseInt(document.getElementById('ticketQuantity').value) || 1;
                const eventId = parseInt(document.getElementById('hiddenEventId').value);

                const response = await fetch('/Reservation/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ EventId: eventId, TicketNumber: quantity })
                });

                if (!response.ok){
                    throw new Error("Failed to add to cart");
                }

                const data = await response.json();
                cartCountSpan.textContent = data.count;
                eventModal.hide();
                document.getElementById('ticketQuantity').value = 1;
            } catch (err) {
                console.error('Error adding to cart:', err);
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            eventModal = new bootstrap.Modal(document.getElementById('eventDetailModal'));

            loadEvents(1);

            document.getElementById("filterForm").addEventListener("submit", e => {
                e.preventDefault();
                loadEvents(1);
            });

            const clearBtn = document.getElementById('btnClearFilters');
            clearBtn.addEventListener('click', () => {
                const form = document.getElementById('filterForm');
                form.reset();
                loadEvents(1);
            });

            document.getElementById('btnAddToCart')?.addEventListener('click', addToCart);
        });
    </script>
}