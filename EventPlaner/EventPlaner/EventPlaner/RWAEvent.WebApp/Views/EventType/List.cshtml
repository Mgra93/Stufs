@model RWAEvent.WebApp.ViewsModel.EventTypeVM
@using Microsoft.AspNetCore.Mvc.Localization
@using RWAEvent.BL.Models.DTO
@using RWAEvent.BL.Models.DTO.EventType
@inject IViewLocalizer Localizer

@{
    var tempEventType = new EventTypeDTO();
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="app-title">
                @Localizer["lblTitle"]
            </h2>
            @using (Html.BeginForm("List", "EventType", FormMethod.Post))
            {
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Filter.Search, new { @class = "form-label app-label" })
                        @Html.TextBoxFor(m => m.Filter.Search, new { @class = "form-control", placeholder = Localizer["lblSearchPlaceholder"].Value })
                    </div>
                    <div class="col d-flex justify-content-end align-items-end gap-2">
                        @if (User.IsInRole("Admin"))
                        {
                            <a href="@Url.Action("Create", "EventType")"
                               class="btn btn-success d-flex align-items-center justify-content-center"
                               style="width: 40px; height: 40px; border-radius: 50%; padding: 0;">
                                <i class="bi bi-calendar-plus text-white" style="font-size: 1.5rem;"></i>
                            </a>
                        }

                        <button type="submit" class="btn btn-warning d-flex align-items-center justify-content-center px-3"
                                style="height: 38px; min-width: 110px;">
                            <i class="bi bi-funnel-fill me-2"></i>
                        </button>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-md-12 d-flex justify-content-end text-end">
                        <span class="me-2 page-size-label">@Localizer["lblShow"]</span>
                        @foreach (var size in new[] { 10, 25, 50 })
                        {
                            if (Model.Filter.PageSize == size)
                            {
                                <span class="fw-bold text-decoration-underline me-2 page-size-label">@size</span>
                            }
                            else
                            {
                                <a class="me-2 page-size-link" href="@Url.Action("List", new { page = 1, search = Model.Filter.Search, pageSize = size })">@size</a>
                            }
                        }
                        <span class="page-size-label">@Localizer["lblItems"]</span>
                    </div>
                </div>
            }
            <div class="mt-4"></div>

            <div style="max-height: 400px; overflow-y: auto;">
                <table class="table table-striped table-bordered text-center align-middle bg-white">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50%;">@Html.LabelFor(m => tempEventType.Name, new { @class = "form-label app-label" })</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th style="width: 50%;" class="app-label">@Localizer["lblAction"]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.EventTypes)
                        {
                            <tr>
                                <td>@Html.DisplayFor(m => item.Name)</td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td class="text-center align-middle">
                                        <div class="d-inline-flex gap-1">
                                            <a href="/EventType/Edit/@item.Id" class="btn btn-primary btn-sm">
                                                @Localizer["btnEdit"]
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    @Localizer["btnDelete"]
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                @Html.ValidationMessageFor(m => m.EventTypes, "", new { @class = "text-danger small" })
                @Html.ValidationMessageFor(m => m.CurrentPage, "", new { @class = "text-danger small" })
                @Html.ValidationMessageFor(m => m.TotalPages, "", new { @class = "text-danger small" })
                @Html.ValidationMessageFor(m => m.Filter, "", new { @class = "text-danger small" })
            </div>

            @if (Model.TotalPages > 0)
            {
                <nav class="mt-4 d-flex justify-content-center" aria-label="Performer pagination">
                    <ul class="pagination">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("List", new { page = Model.CurrentPage - 1, search = Model.Filter.Search })">
                                &laquo;
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("List", new { page = i, search = Model.Filter.Search })">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("List", new { page = Model.CurrentPage + 1, search = Model.Filter.Search })">
                                &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
