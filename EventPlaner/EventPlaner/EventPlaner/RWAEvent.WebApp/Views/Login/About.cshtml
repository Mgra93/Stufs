@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container-fluid">
    <div class="row justify-content-end">
        <div class="col-12 col-md-6 col-lg-5 mt-5 text-center">
            <p class="landing-text mb-3">@Localizer["lblDescription"]</p>
            <h1 class="landing-title mb-4">@Localizer["lblAppName"]</h1>
            <a href="/Event/List" class="btn btn-warning btn-lg">@Localizer["btnEnter"]</a>
        </div>
    </div>
</div>