@model RWAEvent.WebApp.ViewsModel.LoginVM
@using RWAEvent.WebApp.ViewsModel
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    var languages = (List<string>)ViewBag.Languages ?? new List<string>();
    var selectedLanguage = (string)ViewBag.SelectedLanguage ?? "hr";
}

<div class="container mt-5">
   
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="app-title">
                @Localizer["lblTitle"]
            </h2>
            @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="mb-3">
                    @Html.LabelFor(m => m.Username, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label app-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-success flex-fill">
                        @Localizer["btnLogin"]
                    </button>
                    <a href="/Login/Registration" class="btn btn-primary flex-fill">
                        @Localizer["btnRegister"]
                    </a>
                </div>
                <div class="mb-3">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger text-center mb-3" })
                </div>
                @Html.HiddenFor(m => m.SelectedLanguage)
                @Html.ValidationMessageFor(m => m.SelectedLanguage, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.ReturnUrl)

                <div class="mb-3 mt-4 d-flex justify-content-center">
                    <div style="width: 25%;">
                        @Html.DropDownListFor(
                            m => m.SelectedLanguage,
                            new SelectList(languages, selectedLanguage),
                            new { @class = "form-select", onchange = "window.location.href='/Login/ChangeLanguage?culture=' + this.value" }
                        )
                    </div>
                </div>
            }
        </div>
    </div>
</div>