@model RWAEvent.WebApp.ViewsModel.RegistrationVM
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="app-title">
                @Localizer["lblTitle"]
            </h2>
            @using (Html.BeginForm("Registration", "Login", FormMethod.Post))
            {
                <div class="mb-3">
                    @Html.LabelFor(m => m.Username, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.FirstName, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.LastName, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Phone, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", type = "tel" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label app-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                </div>


                <div class="mb-3">
                    @Html.LabelFor(m => m.RepeatPassword, new { @class = "form-label app-label" })
                    @Html.PasswordFor(m => m.RepeatPassword, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.RepeatPassword, "", new { @class = "text-danger" })
                </div>
                <div class="mb-3">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger text-center mb-3" })
                </div>
                <div class="d-flex gap-2 mt-3" style="min-width: 0;">
                    <a href="/Login/Login" class="btn btn-danger flex-fill">
                        @Localizer["btnBack"]
                    </a>
                    <button type="submit" class="btn btn-success flex-fill">
                        @Localizer["btnRegister"]
                    </button>
                </div>
            }
        </div>
    </div>
</div>