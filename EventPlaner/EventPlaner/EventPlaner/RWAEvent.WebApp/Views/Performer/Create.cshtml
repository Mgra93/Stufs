@model PerformerDTO
@using Microsoft.AspNetCore.Mvc.Localization
@using RWAEvent.BL.Models.DTO
@using RWAEvent.BL.Models.DTO.Performer
@inject IViewLocalizer Localizer

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <h2 class="app-title">
                @Localizer["lblTitle"]
            </h2>

            @using (Html.BeginForm("Create", "Performer", FormMethod.Post))
            {
                <div class="mb-3">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.LastName, new { @class = "form-label app-label" })
                    @Html.TextBoxFor(m => m.LastName, new { @class = "form-control" })
                </div>

                <div class="d-flex gap-2 mt-3" style="min-width: 0;">
                    <button type="submit" class="btn btn-success flex-fill">
                        @Localizer["btnSave"]
                    </button>
                    <a href="@Url.Action("List", "Performer")"
                       class="btn btn-danger flex-fill text-center d-flex align-items-center justify-content-center"
                       style="font-size: 1.25rem;">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
