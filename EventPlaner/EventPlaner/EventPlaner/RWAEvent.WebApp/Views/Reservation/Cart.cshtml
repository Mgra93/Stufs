@model RWAEvent.WebApp.ViewsModel.CartVM
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<div id="cart-container">
    @if (Model?.Reservations == null || !Model.Reservations.Any())
    {
        <div class="text-center p-3">
            <i class="bi bi-cart-x" style="font-size: 2rem;"></i>
            <p class="mt-2">@Localizer["msgEmptyCart"]</p>
        </div>
    }
    else
    {
        <div class="list-group">
            @foreach (var item in Model.Reservations)
            {
                var lineTotal = (item.Event?.Price ?? 0) * item.TicketNumber;
                <div class="list-group-item d-flex justify-content-between align-items-center" id="cart-item-@item.EventId">
                    <div>
                        <h6 class="mb-1">@item.Event?.Title</h6>
                        <small>
                            @Html.LabelFor(m => item.TicketNumber)
                            @Html.DisplayFor(m => item.TicketNumber) ×
                            @(item.Event?.Price?.ToString("0.00") ?? "0.00") € =
                            <strong>@(((item.Event?.Price ?? 0m) * item.TicketNumber).ToString("0.00")) €</strong>
                        </small>
                    </div>

                    <div class="ms-auto">
                        <button type="button" class="btn btn-danger btn-remove-item ms-2" data-id="@item.EventId" title="Delete">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Total, "", new { @class = "text-danger" })
                </div>
            }
        </div>

        <div class="mt-3 text-end">
            <p>
                <span id="cart-total">@Model.Total.ToString("0.00")</span> €
            </p>
            <div class="d-flex justify-content-end gap-2">
                <a href="/Reservation/Buy" class="btn btn-success">
                    <i class="bi bi-credit-card"></i> @Localizer["btnBuy"]
                </a>
                <a href="/Event/List" class="btn btn-danger">
                    <i class="bi bi-arrow-left-circle"></i> @Localizer["btnBack"]
                </a>
            </div>
        </div>
    }
</div>
