@using RWAEvent.BL.Models.DTO
@using RWAEvent.BL.Models.DTO.Reservation
@using RWAEvent.BL.Models.Enums
@model RWAEvent.WebApp.ViewsModel.ReservationVM
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var tempReservation = new ReservationDTO();
}

<div class="container-fluid mt-5 px-4">
    <div class="row">
        <div class="col-md-12">
            <h2 class="app-title">
                @Localizer["lblTitle"]
            </h2>

            @using (Html.BeginForm("List", "Reservation", FormMethod.Post))
            {
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        @Html.LabelFor(m => m.Filter.Search, Localizer["filSearch"].Value, new { @class = "form-label app-label" })
                        @Html.TextBoxFor(m => m.Filter.Search, new { @class = "form-control", placeholder = Localizer["lblSearchPlaceholder"].Value })
                    </div>

                    <div class="col-md-9 d-flex justify-content-end align-items-end gap-2">
                        <button type="submit"
                                class="btn btn-warning d-flex align-items-center justify-content-center px-3"
                                style="height: 38px; min-width: 110px;">
                            <i class="bi bi-funnel-fill me-2"></i>
                        </button>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-md-12 d-flex justify-content-end text-end">
                        <span class="me-2 page-size-label">@Localizer["lblShow"]</span>
                        @foreach (var size in new[] { 10, 25, 50 })
                        {
                            if (Model.Filter.PageSize == size)
                            {
                                <span class="fw-bold text-decoration-underline me-2 page-size-label">@size</span>
                            }
                            else
                            {
                                <a class="me-2 page-size-link" href="@Url.Action("List", new { page = 1, search = Model.Filter.Search, pageSize = size })">@size</a>
                            }
                        }
                        <span class="page-size-label">@Localizer["lblItems"]</span>
                    </div>
                </div>
            }

            <div class="mt-4"></div>

            <div style="max-height: 400px; overflow-y: auto;">
                <table class="table table-striped table-bordered text-center bg-white">
                    <thead class="table-light">
                        <tr>
                            <th class="w-40">@Html.LabelFor(m => tempReservation.Event.Title, new { @class = "form-label app-label" })</th>
                            <th class="w-40">@Html.LabelFor(m => tempReservation.Event.EventTypeId, new { @class = "form-label app-label" })</th>
                            <th class="w-40">@Html.LabelFor(m => tempReservation.TicketNumber, new { @class = "form-label app-label" })</th>
                            <th class="w-40">@Html.LabelFor(m => tempReservation.Event.Time, new { @class = "form-label app-label" })</th>
                            <th class="w-40">@Html.LabelFor(m => tempReservation.Event.Location, new { @class = "form-label app-label" })</th>
                            <th class="w-40">@Html.LabelFor(m => tempReservation.CreatedOn, new { @class = "form-label app-label" })</th>
                            <th class="w-40">@Html.LabelFor(m => tempReservation.TotalPrice, new { @class = "form-label app-label" })</th>
                            <th class="w-40">@Html.LabelFor(m => tempReservation.Status, new { @class = "form-label app-label" })</th>

                            @if (User.IsInRole("Admin"))
                            {
                                <th class="w-40">@Html.LabelFor(m => tempReservation.User, new { @class = "form-label app-label" })</th>
                                <th class="w-40 app-label">@Localizer["lblAction"]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Reservations)
                        {
                            <tr style="cursor:pointer;" onclick="window.location='@Url.Action("Details", "Reservation", new { id = item.Id })'">
                                <td>@Html.DisplayFor(res => item.Event.Title)</td>
                                <td>@Html.DisplayFor(res => item.Event.EventType.Name)</td>
                                <td>@Html.DisplayFor(res => item.TicketNumber)</td>
                                <td>@Html.DisplayFor(res => item.Event.Time)</td>
                                <td>@Html.DisplayFor(res => item.Event.Location)</td>
                                <td>@Html.DisplayFor(res => item.CreatedOn)</td>
                                <td>@Html.DisplayFor(res => item.TotalPrice) €</td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case 0:
                                            <div class="d-flex align-items-center justify-content-center gap-2">
                                                <span class="badge bg-success">@Localizer["statusActive"]</span>
                                                <a href="@Url.Action("Cancel", "Reservation", new { id = item.Id })"
                                                   class="btn btn-sm btn-outline-danger rounded-circle d-flex align-items-center justify-content-center"
                                                   style="width: 28px; height: 28px;"
                                                   onclick="event.stopPropagation();">
                                                    <i class="bi bi-x-lg"></i>
                                                </a>
                                            </div>
                                            break;
                                        case 1:
                                            <span class="badge bg-danger">@Localizer["statusCanceled"]</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-warning text-dark">@Localizer["statusDone"]</span>
                                            break;
                                    }
                                </td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td>@Html.DisplayFor(res => item.User.Username)</td>

                                    <td class="text-center align-middle">
                                        <div class="d-inline-flex gap-1">
                                            <a href="/Reservation/Edit/@item.Id" class="btn btn-primary btn-sm" onclick="event.stopPropagation();">
                                                @Localizer["btnEdit"]
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="event.stopPropagation();">
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    @Localizer["btnDelete"]
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                <div>
                    @Html.ValidationMessageFor(m => m.CurrentPage, "", new { @class = "text-danger small" })
                    @Html.ValidationMessageFor(m => m.TotalPages, "", new { @class = "text-danger small" })
                    @Html.ValidationMessageFor(m => m.Filter, "", new { @class = "text-danger small" })
                    @Html.ValidationMessageFor(m => m.Reservations, "", new { @class = "text-danger small" })

                </div>
            </div>

            @if (Model.TotalPages > 0)
            {
                <nav class="mt-4 d-flex justify-content-center" aria-label="Performer pagination">
                    <ul class="pagination">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("List", new { page = Model.CurrentPage - 1, search = Model.Filter.Search })">
                                &laquo;
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("List", new { page = i, search = Model.Filter.Search })">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               href="@Url.Action("List", new { page = Model.CurrentPage + 1, search = Model.Filter.Search })">
                                &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
