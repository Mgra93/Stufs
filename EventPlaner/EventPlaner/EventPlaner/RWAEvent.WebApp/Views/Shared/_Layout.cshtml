@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]PlanMeRWA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/icons/bootstrap-icons.css" />
    <link rel="icon" type="image/x-icon" href="~/favicon.png" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand app-title" asp-area="" asp-controller="Login" asp-action="About">@Localizer["btnAbout"]</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link app-label" asp-area="" asp-controller="Event" asp-action="List">@Localizer["btnEvent"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-label" asp-area="" asp-controller="EventType" asp-action="List">@Localizer["btnEventType"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-label" asp-area="" asp-controller="Performer" asp-action="List">@Localizer["btnPerformer"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link app-label" asp-area="" asp-controller="Reservation" asp-action="List">@Localizer["btnReservation"]</a>
                        </li>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-label" asp-area="" asp-controller="User" asp-action="List">@Localizer["btnUser"]</a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item">
                            @if (User.Identity.IsAuthenticated)
                            {
                                <a class="nav-link app-label" id="btnShowCart" style="font-size: 1.5rem; position: relative; display: inline-block;">
                                    <i class="bi bi-cart"></i>
                                    <span id="cartCount"
                                          style="position: absolute; top: 0.5em; right: 0.0em; background-color: red; color: white;
                                                     border-radius: 999px; font-size: 0.65rem; min-width: 18px; height: 18px;
                                                     display: flex; align-items: center; justify-content: center; padding: 0 4px;">
                                        0
                                    </span>
                                </a>
                            }
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link app-label" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" style="font-size: 1.5rem;">
                                <i class="bi bi-person-circle"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                @if (!User.Identity.IsAuthenticated)
                                {
                                    <li>
                                        <a class="dropdown-item" href="/Login/Login">@Localizer["liLogin"]</a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <span class="dropdown-item-text text-muted" style="font-weight: bold;">
                                            @User.Identity.Name
                                        </span>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <a class="dropdown-item" href="/User/Detail">@Localizer["liSetting"]</a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="/Login/Logout">@Localizer["liLogOut"]</a>
                                    </li>
                                }
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-event border-top footer text-muted text-center" style="padding: 5px 0;">
        <div class="container">
            &copy; 2025 - Algebra
        </div>
    </footer>

    <div class="modal fade" id="cartModal" tabindex="-1" aria-labelledby="cartModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-custom">
            <div class="modal-content">
                <div class="modal-header" style="background-color: #3a9ad9; color: white;">
                    <h5 class="modal-title" id="cartModalLabel">@Localizer["lblCart"]</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="cartModalBody"></div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
