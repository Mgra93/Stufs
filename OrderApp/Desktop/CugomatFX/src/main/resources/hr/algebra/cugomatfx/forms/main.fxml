<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.cugomatfx.controllers.MainController"
            styleClass="root-background"
            stylesheets="@../css/style.css">
    <top>
        <HBox styleClass="navbar" spacing="20" alignment="CENTER_LEFT">
            <ImageView fitHeight="60" preserveRatio="true" styleClass="logo">
                <image>
                    <Image url="@../images/logo.png"/>
                </image>
            </ImageView>
            <Button fx:id="btnTable" styleClass="nav-button"/>
            <Button fx:id="btnOrder" styleClass="nav-button"/>
            <Button fx:id="btnWorker" styleClass="nav-button"/>
            <Button fx:id="btnProduct" styleClass="nav-button"/>
            <Button fx:id="btnCategory" styleClass="nav-button"/>
            <Region HBox.hgrow="ALWAYS"/>
            <MenuButton fx:id="mbProfile" styleClass="profile-button">
                <graphic>
                    <FontIcon iconLiteral="fas-user" iconSize="18"/>
                </graphic>
                <items>
                    <MenuItem fx:id="miUser"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="miSetting"/>
                    <MenuItem fx:id="miLogout"/>
                </items>
            </MenuButton>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="spContent" styleClass="content-pane"/>
    </center>
</BorderPane>
