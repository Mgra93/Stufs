<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="hr.algebra.cugomatfx.controllers.ProductPreviewController"
            prefHeight="600" prefWidth="900">
    <top>
        <Label fx:id="lblTitle" styleClass="lbl-title"/>
    </top>
    <center>
        <SplitPane dividerPositions="0.8">
            <VBox spacing="10">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15" />
                </padding>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblCategory" styleClass="lbl-txt"/>
                        <ComboBox fx:id="cbCategory" styleClass="combo-box-style" prefWidth="240"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <HBox spacing="10">
                        <Button fx:id="btnCreateView" styleClass="create-button"/>
                        <Button fx:id="btnUpdateView" styleClass="update-button"/>
                        <Button fx:id="btnDelete" styleClass="delete-button"/>
                    </HBox>
                </HBox>
                <TableView styleClass="table-style" fx:id="tvProduct" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colName"/>
                        <TableColumn fx:id="colCategory"/>
                        <TableColumn fx:id="colPrice"/>
                    </columns>
                </TableView>
            </VBox>
            <StackPane fx:id="spContent"/>
        </SplitPane>
    </center>
</BorderPane>
